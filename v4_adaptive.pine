//@version=5
strategy("V4 SMC", overlay=true, initial_capital=2000, default_qty_type=strategy.percent_of_equity, default_qty_value=20, commission_type=strategy.commission.percent, commission_value=0.05)

swing_base = input.int(200, "Swing Base", 50, 500)
atr_trail = input.float(2.5, "ATR Trail", 0.5, 5.0, 0.5)
rsi_long = input.int(60, "RSI Long Max", 40, 80)
rsi_short = input.int(40, "RSI Short Min", 20, 60)
max_pos = input.float(0.20, "Max Position %", 0.05, 0.50)
use_adx = input.bool(true, "Adaptive ADX")

atr = ta.ema(ta.tr, 14)
rsi = ta.rsi(close, 14)
[dip, dim, adx_val] = ta.dmi(14, 14)
adaptive_swing = use_adx ? int(math.max(120, math.min(280, swing_base + 50 - 2 * (adx_val - 20)))) : swing_base

var float sw_high = na
var float sw_low = na
var bool sw_hc = true
var bool sw_lc = true
sw = adaptive_swing
if bar_index >= sw
    if high[sw] > ta.highest(high, sw)
        sw_high := high
        sw_hc := false
    if low[sw] < ta.lowest(low, sw)
        sw_low := low
        sw_lc := false

var int trend = 0
var float ob_top = na
var float ob_bottom = na
var float invalidation = na
var int lbu = -999
var int lbd = -999
var int lcu = -999
var int lcd = -999

if not sw_hc and not na(sw_high) and close[1] <= sw_high and close > sw_high
    sw_hc := true
    if trend == -1
        lcu := bar_index
    else
        lbu := bar_index
    ob_top := high
    ob_bottom := ta.lowest(low, 50)
    invalidation := na(sw_low) ? sw_high - 3 * atr : sw_low
    trend := 1

if not sw_lc and not na(sw_low) and close[1] >= sw_low and close < sw_low
    sw_lc := true
    if trend == 1
        lcd := bar_index
    else
        lbd := bar_index
    ob_top := ta.highest(high, 50)
    ob_bottom := low
    invalidation := na(sw_high) ? sw_low + 3 * atr : sw_high
    trend := -1

fresh_long = (bar_index - lbu > 0 and bar_index - lbu <= 50) or (bar_index - lcu > 0 and bar_index - lcu <= 30)
fresh_short = (bar_index - lbd > 0 and bar_index - lbd <= 50) or (bar_index - lcd > 0 and bar_index - lcd <= 30)
waited_long = (bar_index - lbu >= 1) and (bar_index - lcu >= 1)
waited_short = (bar_index - lbd >= 1) and (bar_index - lcd >= 1)

long_signal = trend == 1 and fresh_long and waited_long and low <= ob_top and close >= ob_bottom and rsi <= rsi_long
short_signal = trend == -1 and fresh_short and waited_short and high >= ob_bottom and close <= ob_top and rsi >= rsi_short

atr_pct = atr / close
pos_pct = max_pos * math.min(2.0, 0.015 / math.max(atr_pct, 0.001))
pos_pct := math.max(0.02, math.min(max_pos, pos_pct))

var float trail_stop = na

if strategy.position_size == 0
    if long_signal
        trail_stop := na(invalidation) ? close - 2 * atr : invalidation - 0.5 * atr
        strategy.entry("L", strategy.long, qty=strategy.equity * pos_pct / close)
    if short_signal
        trail_stop := na(invalidation) ? close + 2 * atr : invalidation + 0.5 * atr
        strategy.entry("S", strategy.short, qty=strategy.equity * pos_pct / close)

if strategy.position_size > 0
    trail_stop := math.max(trail_stop, na(invalidation) ? trail_stop : invalidation)
    trail_stop := math.max(trail_stop, close - atr_trail * atr)
    strategy.exit("XL", "L", stop=trail_stop)

if strategy.position_size < 0
    trail_stop := math.min(trail_stop, na(invalidation) ? trail_stop : invalidation)
    trail_stop := math.min(trail_stop, close + atr_trail * atr)
    strategy.exit("XS", "S", stop=trail_stop)

if strategy.position_size > 0 and short_signal
    strategy.close("L", comment="Rev")
if strategy.position_size < 0 and long_signal
    strategy.close("S", comment="Rev")

plot(ob_top, "OB Top", color=color.new(color.green, 70))
plot(ob_bottom, "OB Bot", color=color.new(color.red, 70))
plot(trail_stop, "Stop", color=color.orange)
